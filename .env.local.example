NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AI_GATEWAY_API_KEY=

# Phase 3 — Google. Sign-in needs the OAuth client; the rest is only needed once an org
# connects Drive, Calendar, or Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Drive picker runs in the browser, so both of these are public by design. The client id
# is the same value as GOOGLE_CLIENT_ID; the picker key is a Google Cloud *browser* API key
# with the Picker API enabled, restricted by HTTP referrer rather than kept secret. Without
# both, /settings explains that the picker is unconfigured instead of offering a dead button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=

# Wraps the per-row data keys that seal stored refresh tokens. Base64, 32 bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_SOURCE_KEK=
# Set only during a key rotation, holding the outgoing key until the rewrap finishes.
DATA_SOURCE_KEK_PREVIOUS=

# Authorizes the scheduled overdue sweep at /api/cron/reminders.
CRON_SECRET=
